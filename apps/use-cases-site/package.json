    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.0",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "7.3.5"
  },
  "overrides": {
    "esbuild": "0.28.0"
  },
